{
  "name": "ai-agent-coordinator",
  "displayName": "AI Agent Coordinator",
  "description": "Multi-AI Agent Collaboration Coordinator",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "Leesin596",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leesin596/ai-agent-coordinator.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "npm run typecheck && node build.js --prod",
    "watch": "node build.js --watch",
    "compile": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "1.93.0",
    "@types/node": "^18.19.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "coordinator.openPanel",
        "title": "Open Coordinator",
        "icon": "$(hub)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.addEditorContext",
        "title": "添加选中代码或当前文件到输入框",
        "shortTitle": "添加代码上下文",
        "icon": "$(references)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.addFileContext",
        "title": "添加文件到输入框",
        "shortTitle": "添加文件上下文",
        "icon": "$(file-code)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.pickContext",
        "title": "选择代码上下文添加到输入框",
        "shortTitle": "添加上下文",
        "icon": "$(attach)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.addWorkspace",
        "title": "Add Workspace",
        "icon": "$(add)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.switchWorkspace",
        "title": "Switch Workspace",
        "icon": "$(arrow-swap)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.renameWorkspace",
        "title": "Rename Workspace",
        "icon": "$(edit)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.removeWorkspace",
        "title": "Remove Workspace",
        "icon": "$(trash)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.refreshWorkspaces",
        "title": "Refresh Workspaces",
        "icon": "$(refresh)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.addRole",
        "title": "Add Role",
        "icon": "$(add)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.editRole",
        "title": "Edit Role",
        "icon": "$(edit)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.deleteRole",
        "title": "Delete Role",
        "icon": "$(trash)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.refreshRoles",
        "title": "Refresh Roles",
        "icon": "$(refresh)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.refreshBuiltInRoles",
        "title": "刷新内置角色到最新版本",
        "icon": "$(sync)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.refreshSessions",
        "title": "Refresh Sessions",
        "icon": "$(refresh)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.startSession",
        "title": "Start Session",
        "icon": "$(play)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.openSession",
        "title": "Open Session",
        "icon": "$(comment-discussion)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.listSessions",
        "title": "List Sessions",
        "icon": "$(list-unordered)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.deleteSession",
        "title": "Delete Session",
        "icon": "$(trash)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.openTaskCenter",
        "title": "Open Task Center",
        "icon": "$(inbox)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.dispatchTask",
        "title": "Dispatch Task",
        "icon": "$(send)",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.codeAction",
        "title": "Coordinator Code Action",
        "category": "Coordinator"
      },
      {
        "command": "coordinator.rebuildIndex",
        "title": "Rebuild Code Index",
        "icon": "$(refresh)",
        "category": "Coordinator"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coordinator-sidebar",
          "title": "Coordinator",
          "icon": "media/coordinator.svg"
        }
      ],
      "panel": [
        {
          "id": "coordinator-panel",
          "title": "Coordinator",
          "icon": "media/coordinator.svg"
        }
      ]
    },
    "views": {
      "coordinator-sidebar": [
        {
          "type": "webview",
          "id": "coordinator.sidebar",
          "name": "Coordinator",
          "icon": "media/coordinator.svg",
          "visibility": "visible"
        }
      ],
      "coordinator-panel": [
        {
          "type": "webview",
          "id": "coordinatorConsole",
          "name": "Coordinator",
          "contextualTitle": "Coordinator",
          "icon": "media/coordinator.svg",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "coordinator.addEditorContext",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "coordinator.addEditorContext",
          "when": "resourceScheme == file",
          "group": "coordinator@1"
        }
      ],
      "explorer/context": [
        {
          "command": "coordinator.addFileContext",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "coordinator@1"
        }
      ],
      "view/title": [
        {
          "command": "coordinator.openTaskCenter",
          "when": "view == coordinator.sidebar",
          "group": "navigation@1"
        }
      ],
      "view/item/context": []
    },
    "configuration": {
      "title": "AI Agent Coordinator",
      "properties": {
        "coordinator.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API Key"
        },
        "coordinator.llm.baseURL": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "LLM API Base URL"
        },
        "coordinator.llm.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Default LLM Model"
        },
        "coordinator.mcp.servers": {
          "type": "array",
          "default": [],
          "description": "MCP Server 配置列表",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Server 名称" },
              "command": { "type": "string", "description": "启动命令" },
              "args": { "type": "array", "items": { "type": "string" }, "description": "命令参数" },
              "env": { "type": "object", "description": "环境变量" },
              "enabled": { "type": "boolean", "default": true, "description": "是否启用" }
            },
            "required": ["name", "command"]
          }
        },
        "coordinator.autoApprove.tools": {
          "type": "array",
          "default": [],
          "description": "自动批准的工具名称列表（如 workspace_read_file, workspace_list_files, workspace_search, git_status, git_diff）",
          "items": { "type": "string" }
        },
        "coordinator.autoApprove.toolGroups": {
          "type": "array",
          "default": [],
          "description": "自动批准的工具组列表。可选值: read（读取类工具）, edit（编辑类工具）, command（命令执行类工具）, web（联网工具）, mcp（MCP 工具）",
          "items": { "type": "string", "enum": ["read", "edit", "command", "web", "mcp"] }
        },
        "coordinator.autoApprove.always": {
          "type": "boolean",
          "default": false,
          "description": "自动批准所有工具调用（危险！仅用于受信任的隔离环境）"
        },
        "coordinator.web.searchProvider": {
          "type": "string",
          "enum": ["bing", "duckduckgo", "baidu", "mojeek", "searxng", "tavily", "brave"],
          "default": "bing",
          "description": "联网搜索引擎。bing/baidu/mojeek/duckduckgo 无需 API Key；tavily/brave 需配置 searchApiKey；searxng 需配置 searxngUrl"
        },
        "coordinator.web.searchApiKey": {
          "type": "string",
          "default": "",
          "description": "搜索 API Key，仅 tavily/brave 引擎需要"
        },
        "coordinator.web.searxngUrl": {
          "type": "string",
          "default": "",
          "description": "SearXNG 实例 URL，仅 searxng 引擎需要（如 http://localhost:8080）"
        },
        "coordinator.web.jinaReaderEnabled": {
          "type": "boolean",
          "default": true,
          "description": "web_fetch 优先使用 Jina Reader 将网页转 Markdown（免费有限流），限流时自动降级本地 HTML 解析"
        },
        "coordinator.web.denyDomains": {
          "type": "array",
          "default": ["localhost", "127.0.0.1", "0.0.0.0"],
          "items": { "type": "string" },
          "description": "web_fetch 禁止访问的域名黑名单"
        },
        "coordinator.web.maxFetchSize": {
          "type": "integer",
          "default": 50000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "web_fetch 返回内容最大字符数"
        },
        "coordinator.web.requestTimeoutMs": {
          "type": "integer",
          "default": 10000,
          "minimum": 5000,
          "maximum": 60000,
          "description": "联网请求超时时间（毫秒）"
        },
        "coordinator.web.searchFetchCount": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 5,
          "description": "web_search 后自动抓取前 N 条结果的网页正文（0=关闭深度抓取，仅返回摘要）"
        },
        "coordinator.web.searchFetchLength": {
          "type": "integer",
          "default": 4000,
          "minimum": 1000,
          "maximum": 20000,
          "description": "深度抓取时每条结果的正文最大字符数"
        },
        "coordinator.indexing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用代码库语义索引（需配置模型预设的 API Key）"
        },
        "coordinator.indexing.embeddingModel": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "Embedding 模型名称（OpenAI 兼容或 Ollama 模型名）"
        },
        "coordinator.indexing.chunkSize": {
          "type": "integer",
          "default": 100,
          "minimum": 20,
          "maximum": 500,
          "description": "代码分块行数"
        },
        "coordinator.indexing.chunkOverlap": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "description": "分块重叠行数"
        }
      }
    }
  }
}